# Keep all credentials server-side. Never prefix secrets with VITE_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Final total charged, in rupees, including any applicable taxes. No default fee.
WORKSHOP_PRICE_INR=
# Leave empty until the date is confirmed. Include the timezone, e.g. +05:30.
WORKSHOP_STARTS_AT=
WORKSHOP_VENUE=VPS Lakeshore Hospital
# Confirm your published policy URLs before enabling checkout.
TERMS_URL=
PRIVACY_URL=
REFUND_URL=
SUPPORT_EMAIL=support@ai-for-doctors.com
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/workshop.sqlite
# Set NODE_ENV=production when deploying. Set TRUST_PROXY_HOPS only for your actual proxy topology.
TRUST_PROXY_HOPS=0
